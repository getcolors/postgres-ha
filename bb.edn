{:paths ["test/clj" "test/resources"]
 :deps {io.github.getcolors/postgres-ha {:local/root "."}}
 :tasks
 {test {:doc "Run the Babashka unit suite"
        :requires ([clojure.test :as t]
                   [io.github.getcolors.postgres-ha.validate-test]
                   [io.github.getcolors.postgres-ha.utils-test]
                   [io.github.getcolors.postgres-ha.tools-test]
                   [io.github.getcolors.postgres-ha.operator-test]
                   [io.github.getcolors.postgres-ha.workflow-test])
        :task (let [{:keys [fail error]}
                    (t/run-tests 'io.github.getcolors.postgres-ha.validate-test
                                 'io.github.getcolors.postgres-ha.utils-test
                                 'io.github.getcolors.postgres-ha.tools-test
                                 'io.github.getcolors.postgres-ha.operator-test
                                 'io.github.getcolors.postgres-ha.workflow-test)]
                (System/exit (if (pos? (+ fail error)) 1 0)))}
  golden {:doc "Diff the rendered tree against the committed golden"
          :task (shell "./scripts/golden.sh")}
  golden:accept {:doc "Regenerate the golden after inspecting the diff"
                 :task (shell "./scripts/golden.sh" "--accept")}
  pin {:doc "Stamp the bundled launcher after a clean pushed commit"
       :task (load-file "tasks/pin.clj")}}}
