# package-postgres-ha-blue = { git = "https://github.com/getcolors/postgres-ha.git", rev = "4218bb18ca2272665c61ff1d417dc667c46bfeb8", subdirectory = "blue" }
# blue = { git = "https://github.com/getcolors/blue.git", rev = "290f313ead5ca162875c33a049c880da017eae09" }
#
# [tool.uv]
# override-dependencies = ["blue @ git+https://github.com/getcolors/blue.git@290f313ead5ca162875c33a049c880da017eae09"]
# ///
#
# Managed by `bb pin` — do not edit by hand, and never invent a SHA.
#
# Stamped by `bb pin`. POSTGRES_HA_LIB_ROOT=/path/to/postgres-ha still overrides the
# pin with a working tree.
"""Thin launcher for package-postgres-ha-blue.

This file is both the skill payload and the repository entry point —
blue/blue in the repository is a symlink to it. It deliberately holds no
logic of its own: validation, the graph, the steps and the operator verbs all
live in the package-postgres-ha-blue library, where the test suite reaches
them. A copied payload is the one place in this project where code cannot be
tested, so nothing that can live elsewhere should live here.
"""

import os
import subprocess
import sys

UNPINNED_ERROR = """\
this launcher carries no postgres-ha pin.
It has not been stamped by `bb pin`, which cannot run until the postgres-ha
repository has been pushed.
Point it at a checkout meanwhile: POSTGRES_HA_LIB_ROOT=/path/to/postgres-ha
(or run through the repository project: cd postgres-ha/blue && uv run python -m package_postgres_ha_blue ...)
"""


def _lib_root_project(root: str) -> str:
    """The uv project inside a POSTGRES_HA_LIB_ROOT checkout: the repository
    root or its blue/ implementation both work."""
    if os.path.isfile(os.path.join(root, "pyproject.toml")):
        return root
    return os.path.join(root, "blue")


def main() -> None:
    root = os.environ.get("POSTGRES_HA_LIB_ROOT")
    if root:
        result = subprocess.run(
            ["uv", "run", "--project", _lib_root_project(root),
             "python", "-m", "package_postgres_ha_blue", *sys.argv[1:]])
        raise SystemExit(result.returncode)
    try:
        from package_postgres_ha_blue import exec  # resolvable only once pinned
    except ImportError:
        sys.stderr.write(UNPINNED_ERROR)
        raise SystemExit(2)
    exec()


if __name__ == "__main__":
    main()
